# Mesmo banco do painel (se omitido, é lido de server/.env)
DATABASE_URL=

# --- Triagem com IA (python -m carcara triage) ---
ANTHROPIC_API_KEY=
# Modelo usado na triagem; troque por um mais barato se preferir
CLAUDE_MODEL=claude-opus-5-5

# --- Avisos e relatórios por e-mail (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# --- Avisos por webhook (opcional): n8n, Zapier, Make, bot de WhatsApp/Telegram ---
ALERT_WEBHOOK_URL=

# --- Serviço de diagnóstico (python -m carcara serve) ---
# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula
CORS_ORIGINS=https://carcara-tech.vercel.app
