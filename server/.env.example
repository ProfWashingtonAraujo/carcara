# Neon: copie a connection string do painel (Connection Details)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Chave de criptografia dos dados pessoais (leads e clientes). Guarde um backup: sem ela os dados não podem ser lidos.
# Use o MESMO valor no Render, no GitHub Actions (secret DATA_KEY) e em python/.env.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=

# Usuário criado automaticamente na primeira execução (banco sem usuários)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

PORT=3000
